<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sandbox off for direct distribution — see DebugProfile.entitlements for
	  the reasoning. The Mac App Store build is a separate configuration that
	  turns the sandbox back on and disables the local shell.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Outbound TCP, for SSH and SFTP. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!--
	  Required by `file_picker` to open the "choose a file" panel, which is how
	  a user picks something to upload. The plugin checks for this entitlement
	  itself and refuses without it, whether or not the sandbox is on — with no
	  entitlement the upload button did nothing at all. Outside the sandbox it
	  grants nothing extra; inside one it is the standard, narrowest form of
	  file access: only what the user explicitly chooses in the panel.
	-->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
